// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

//////////////////////
// ENUMS
//////////////////////

enum StaffRole {
  ADMIN    // Full access — restaurant owner
  MANAGER  // Manage staff, menu, tables, reservations
  WAITER   // View & manage assigned reservations/orders
  KITCHEN  // Read-only access to orders
}

model RolePermission {
  id          Int       @id @default(autoincrement())
  role        StaffRole @unique
  permissions String[]  // Array of permission strings
}

//////////////////////
// CORE ENTITIES
//////////////////////

model Restaurant {
  id            Int                     @id @default(autoincrement())
  name          String
  address       String
  phone         String
  email         String                  @unique
  isActive      Boolean                 @default(true)
  createdAt     DateTime                @default(now())

  tables        DiningTable[]
  categories    MenuCategory[]
  menuItems     MenuItem[]
  reservations  Reservation[]
  promotions    Promotion[]
  subscriptions RestaurantSubscription[]
  payments      Payment[]
}

model Staff {
  id        Int       @id @default(autoincrement())
  name      String
  email     String    @unique
  password  String
  role      StaffRole @default(WAITER)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
}

model Customer {
  id            Int                  @id @default(autoincrement())
  firstName     String
  lastName      String
  email         String               @unique
  password      String
  mobileNumber  String
  loyaltyPoints Int                  @default(0)
  createdAt     DateTime             @default(now())

  reservations  Reservation[]
  loyaltyTxns   LoyaltyTransaction[]
}

//////////////////////
// RESTAURANT STRUCTURE
//////////////////////

model DiningTable {
  id           Int        @id @default(autoincrement())
  restaurantId Int
  tableNumber  Int
  capacity     Int
  location     String?
  isActive     Boolean    @default(true)

  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  reservations Reservation[]
}

model MenuCategory {
  id           Int        @id @default(autoincrement())
  restaurantId Int
  name         String

  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  menuItems    MenuItem[]
}

model MenuItem {
  id           Int        @id @default(autoincrement())
  restaurantId Int
  categoryId   Int?
  name         String
  description  String?
  price        Decimal    @db.Decimal(10, 2)
  imageUrl     String?
  isAvailable  Boolean    @default(true)

  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category     MenuCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  orders       ReservationOrder[]
}

//////////////////////
// RESERVATION SYSTEM
//////////////////////

model Reservation {
  id              Int        @id @default(autoincrement())
  restaurantId    Int
  customerId      Int
  tableId         Int?
  reservationDate DateTime   @db.Date
  startTime       DateTime   @db.Time
  endTime         DateTime?  @db.Time
  guestCount      Int
  status          String     @default("PENDING")
  specialRequest  String?
  createdAt       DateTime   @default(now())

  restaurant      Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customer        Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  table           DiningTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)

  decoration      DecorationRequest?
  orders          ReservationOrder[]
}

model DecorationRequest {
  id            Int         @id @default(autoincrement())
  reservationId Int         @unique
  eventType     String?
  notes         String?
  extraCost     Decimal     @default(0) @db.Decimal(10, 2)

  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
}

model ReservationOrder {
  id            Int        @id @default(autoincrement())
  reservationId Int
  menuItemId    Int
  quantity      Int
  price         Decimal    @db.Decimal(10, 2)

  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  menuItem      MenuItem    @relation(fields: [menuItemId], references: [id])
}

//////////////////////
// PROMOTION & LOYALTY
//////////////////////

model Promotion {
  id              Int        @id @default(autoincrement())
  restaurantId    Int
  title           String
  description     String?
  discountPercent Int?
  startDate       DateTime?  @db.Date
  endDate         DateTime?  @db.Date
  isActive        Boolean    @default(true)

  restaurant      Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

model LoyaltyTransaction {
  id         Int      @id @default(autoincrement())
  customerId Int
  points     Int
  type       String
  createdAt  DateTime @default(now())

  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

//////////////////////
// SAAS BILLING / ERP
//////////////////////

model SubscriptionPlan {
  id                       Int      @id @default(autoincrement())
  name                     String
  price                    Decimal  @db.Decimal(10, 2)
  maxTables                Int?
  maxReservationsPerMonth  Int?

  subscriptions            RestaurantSubscription[]
}

model RestaurantSubscription {
  id           Int       @id @default(autoincrement())
  restaurantId Int
  planId       Int
  startDate    DateTime  @db.Date
  endDate      DateTime? @db.Date
  isActive     Boolean   @default(true)

  restaurant   Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  plan         SubscriptionPlan @relation(fields: [planId], references: [id])
}

model Payment {
  id           Int       @id @default(autoincrement())
  restaurantId Int
  amount       Decimal   @db.Decimal(10, 2)
  paymentDate  DateTime  @default(now())
  method       String?
  status       String?

  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}
