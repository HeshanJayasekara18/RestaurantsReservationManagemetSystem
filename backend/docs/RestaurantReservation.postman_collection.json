        {
          "name": "Delete Customer (ADMIN)",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/customers/1", "host": ["{{baseUrl}}"], "path": ["customers", "1"] }
          }
        }
      ]
    },
    {
      "name": "🪑 Tables",
      "item": [
