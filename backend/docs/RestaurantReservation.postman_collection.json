        {
          "name": "Get Table by ID (Public)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/tables/1", "host": ["{{baseUrl}}"], "path": ["tables", "1"] }
          }
        },
        {
          "name": "Create Table (ADMIN, MANAGER)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"restaurantId\": 1,\n  \"tableNumber\": 5,\n  \"capacity\": 4,\n  \"location\": \"Window side\",\n  \"isActive\": true\n}"
            },
            "url": { "raw": "{{baseUrl}}/tables", "host": ["{{baseUrl}}"], "path": ["tables"] }
          }
        },
        {
          "name": "Update Table (ADMIN, MANAGER)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"capacity\": 6,\n  \"location\": \"Garden\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/tables/1", "host": ["{{baseUrl}}"], "path": ["tables", "1"] }
          }
        },
        {
          "name": "Delete Table (ADMIN, MANAGER)",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/tables/1", "host": ["{{baseUrl}}"], "path": ["tables", "1"] }
          }
        }
      ]
    },
    {
      "name": "📅 Reservations",
      "item": [
        {
          "name": "Create Reservation (CUSTOMER)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{customerToken}}", "type": "string" }]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"restaurantId\": 1,\n  \"customerId\": 1,\n  \"tableId\": 1,\n  \"reservationDate\": \"2026-03-10\",\n  \"startTime\": \"2026-03-10T18:00:00.000Z\",\n  \"endTime\": \"2026-03-10T20:00:00.000Z\",\n  \"guestCount\": 4,\n  \"specialRequest\": \"Window seat preferred, nut allergy\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/reservations", "host": ["{{baseUrl}}"], "path": ["reservations"] }
          }
        },
        {
          "name": "List All Reservations (ADMIN, MANAGER, WAITER)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/reservations", "host": ["{{baseUrl}}"], "path": ["reservations"] }
          }
        },
        {
          "name": "Reservations by Restaurant",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/reservations/restaurant/1", "host": ["{{baseUrl}}"], "path": ["reservations", "restaurant", "1"] }
          }
        },
        {
          "name": "Reservations by Customer",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{customerToken}}", "type": "string" }]
            },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/reservations/customer/1", "host": ["{{baseUrl}}"], "path": ["reservations", "customer", "1"] }
          }
        },
        {
          "name": "Get Reservation by ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/reservations/1", "host": ["{{baseUrl}}"], "path": ["reservations", "1"] }
          }
        },
        {
          "name": "Update Reservation (confirm/reschedule)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"CONFIRMED\",\n  \"tableId\": 2,\n  \"guestCount\": 5\n}"
            },
            "url": { "raw": "{{baseUrl}}/reservations/1", "host": ["{{baseUrl}}"], "path": ["reservations", "1"] }
          }
        },
        {
          "name": "Delete Reservation (cancel)",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/reservations/1", "host": ["{{baseUrl}}"], "path": ["reservations", "1"] }
          }
        }
      ]
    },
