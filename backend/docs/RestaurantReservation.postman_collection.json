{
  "info": {
    "name": "Restaurant Reservation System",
    "description": "Full API collection for the Restaurant Reservation System backend.\n\nBase URL: http://localhost:7000\n\n## Setup\n1. Import this file into Postman\n2. Set the collection variable `baseUrl` to your server URL (default: http://localhost:7000)\n3. Use the login endpoints first — the token is saved automatically to `staffToken` or `customerToken`\n4. All protected routes automatically use the saved token via the collection-level Auth header.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:7000", "type": "string" },
    { "key": "staffToken", "value": "", "type": "string" },
    { "key": "customerToken", "value": "", "type": "string" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{staffToken}}", "type": "string" }]
  },
  "item": [
    {
      "name": "🔑 Auth",
      "item": [
        {
          "name": "Login Staff",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.access_token) {",
                  "  pm.collectionVariables.set('staffToken', res.access_token);",
                  "  console.log('Staff token saved!');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@savorhouse.com\",\n  \"password\": \"admin123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login/staff", "host": ["{{baseUrl}}"], "path": ["auth", "login", "staff"] }
          }
        },
        {
          "name": "Login Customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.access_token) {",
                  "  pm.collectionVariables.set('customerToken', res.access_token);",
                  "  console.log('Customer token saved!');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"pass123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login/customer", "host": ["{{baseUrl}}"], "path": ["auth", "login", "customer"] }
          }
        },
        {
          "name": "Register Customer",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"pass123\",\n  \"mobileNumber\": \"+94771234567\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register/customer", "host": ["{{baseUrl}}"], "path": ["auth", "register", "customer"] }
          }
        },
        {
          "name": "Create Staff (ADMIN only)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Bob Waiter\",\n  \"email\": \"bob@savorhouse.com\",\n  \"password\": \"staff123\",\n  \"role\": \"WAITER\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/staff", "host": ["{{baseUrl}}"], "path": ["auth", "staff"] }
          }
        },
        {
          "name": "List All Staff (ADMIN only)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/auth/staff", "host": ["{{baseUrl}}"], "path": ["auth", "staff"] }
          }
        },
        {
          "name": "Get Me (any authenticated role)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] }
          }
        }
      ]
    },
    {
      "name": "🏠 Restaurants",
      "item": [
        {
          "name": "List All Restaurants (Public)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/restaurants", "host": ["{{baseUrl}}"], "path": ["restaurants"] }
          }
        },
        {
          "name": "Get Restaurant by ID (Public)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/restaurants/1", "host": ["{{baseUrl}}"], "path": ["restaurants", "1"] }
          }
        },
        {
          "name": "Create Restaurant (ADMIN)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Savor House\",\n  \"address\": \"42 Galle Rd, Colombo 03\",\n  \"phone\": \"+94112345678\",\n  \"email\": \"info@savorhouse.com\",\n  \"password\": \"rest_secret\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/restaurants", "host": ["{{baseUrl}}"], "path": ["restaurants"] }
          }
        },
        {
          "name": "Update Restaurant (ADMIN)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"+94119876543\",\n  \"address\": \"45 Galle Rd, Colombo 03\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/restaurants/1", "host": ["{{baseUrl}}"], "path": ["restaurants", "1"] }
          }
        },
        {
          "name": "Delete Restaurant (ADMIN)",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/restaurants/1", "host": ["{{baseUrl}}"], "path": ["restaurants", "1"] }
          }
        }
      ]
    },
    {
      "name": "👥 Customers",
      "item": [
        {
          "name": "List All Customers (ADMIN, MANAGER)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/customers", "host": ["{{baseUrl}}"], "path": ["customers"] }
          }
        },
        {
          "name": "Get Customer by ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/customers/1", "host": ["{{baseUrl}}"], "path": ["customers", "1"] }
          }
        },
        {
          "name": "Update Customer",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mobileNumber\": \"+94770000001\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/customers/1", "host": ["{{baseUrl}}"], "path": ["customers", "1"] }
